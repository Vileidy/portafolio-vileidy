---
import patron from '../assets/brand/patron-v.svg';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="pie__banda" style={`--patron: url(${patron.src})`} aria-hidden="true"></div>
  <div class="wrap pie__fila">
    <p class="pie__firma">{site.nombre}</p>
    <p class="pie__texto">{site.rol} · © {anio}</p>
    <a class="pie__subir btn" href={`${base}#inicio`} style="--c: var(--aqua)">Volver arriba ↑</a>
  </div>
</footer>

<style>
  .pie {
    margin-top: clamp(1.5rem, 4vw, 3rem);
    border-top: var(--line);
    background: var(--cream);
  }

  .pie__banda {
    height: clamp(4rem, 9vw, 7.5rem);
    border-bottom: var(--line);
    background: var(--patron) center 18% / cover no-repeat;
  }

  .pie__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 2rem 2.5rem;
  }

  .pie__firma {
    font-family: var(--font-script);
    font-size: clamp(2.6rem, 6vw, 3.6rem);
    line-height: 1;
  }

  .pie__texto {
    margin-right: auto;
    color: var(--ink-soft);
    font-weight: 600;
  }
</style>
