---
/** Visor de imágenes: <dialog> nativo (foco, Escape y capa de fondo los maneja el navegador). */
---

<dialog id="lightbox" class="lb" aria-label="Visor de imágenes" data-lenis-prevent>
  <div class="lb__marco">
    <button type="button" class="lb__cerrar" aria-label="Cerrar visor" data-lb-cerrar>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg>
    </button>

    <div class="lb__zona" data-lb-zona>
      <img class="lb__img" alt="" data-lb-img />
    </div>

    <div class="lb__pie">
      <div class="lb__texto">
        <p class="lb__marca" data-lb-marca></p>
        <p class="lb__titulo" data-lb-titulo></p>
        <p class="lb__desc" data-lb-desc></p>
        <p class="lb__meta" data-lb-meta></p>
        <a class="lb__proyecto btn" data-lb-proyecto hidden>Ver el proyecto →</a>
      </div>

      <div class="lb__controles">
        <button type="button" class="lb__zoom" data-lb-zoom aria-pressed="false">Ampliar</button>
        <p class="lb__contador" data-lb-contador aria-live="polite"></p>
        <button type="button" class="lb__nav" aria-label="Anterior" data-lb-prev>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button type="button" class="lb__nav" aria-label="Siguiente" data-lb-next>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
    </div>
  </div>
</dialog>

<style>
  .lb {
    width: 100%;
    max-width: 100vw;
    height: 100%;
    max-height: 100dvh;
    padding: 0.5rem;
    border: 0;
    background: transparent;
    color: var(--ink);
    overflow: hidden;
  }

  .lb:not([open]) {
    display: none;
  }

  .lb[open] {
    display: grid;
    place-items: center;
  }

  .lb::backdrop {
    background: rgb(35 27 58 / 0.72);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .lb__marco {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    width: min(1100px, 100%);
    max-height: calc(100dvh - 1rem);
    overflow: hidden;
    border: var(--line);
    border-radius: 28px;
    background: var(--cream);
    box-shadow: 8px 8px 0 var(--ink);
  }

  .lb__cerrar {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border: var(--line);
    border-radius: 50%;
    background: var(--pink);
    cursor: pointer;
    transition: transform 0.3s var(--ease-pop);
  }

  @media (hover: hover) {
    .lb__cerrar:hover {
      transform: rotate(90deg) scale(1.08);
    }
  }

  .lb__zona {
    display: grid;
    place-items: center;
    min-height: 0;
    padding: 1rem;
    overflow: auto;
    background:
      radial-gradient(circle, rgb(35 27 58 / 0.1) 1.4px, transparent 1.6px) 0 0 / 16px 16px,
      color-mix(in srgb, var(--lav) 40%, var(--cream));
    cursor: zoom-in;
  }

  .lb__zona[data-zoom='on'] {
    place-items: start center;
    cursor: zoom-out;
  }

  .lb__img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(100dvh - 15.5rem);
    border-radius: 10px;
    box-shadow: 0 8px 28px rgb(35 27 58 / 0.25);
    background: var(--paper);
  }

  .lb__zona[data-zoom='on'] .lb__img {
    max-width: none;
    max-height: none;
  }

  .lb__pie {
    display: grid;
    gap: 0.9rem;
    padding: 1rem 1.25rem 1.1rem;
    border-top: var(--line);
    background: var(--cream);
  }

  .lb__texto {
    display: grid;
    gap: 0.25rem;
    justify-items: start;
  }

  .lb__marca {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .lb__titulo {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    line-height: 1.05;
  }

  .lb__desc {
    max-width: 46rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .lb__desc:empty,
  .lb__meta:empty {
    display: none;
  }

  .lb__meta {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .lb__proyecto {
    margin-top: 0.4rem;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    box-shadow: 3px 3px 0 var(--ink);
    --c: var(--aqua);
  }

  .lb__controles {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .lb__zoom {
    padding: 0.4rem 1rem;
    border: var(--line);
    border-radius: 999px;
    background: var(--butter);
    font-weight: 600;
    cursor: pointer;
  }

  .lb__zoom[aria-pressed='true'] {
    background: var(--aqua);
  }

  .lb__contador {
    margin-left: auto;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .lb__nav {
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border: var(--line);
    border-radius: 50%;
    background: var(--lav);
    cursor: pointer;
    transition: transform 0.3s var(--ease-pop);
  }

  .lb__nav:disabled {
    opacity: 0.35;
    cursor: default;
  }

  @media (hover: hover) {
    .lb__nav:not(:disabled):hover {
      transform: scale(1.12);
    }
  }

  @media (min-width: 760px) {
    .lb__pie {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .lb__img {
      max-height: calc(100dvh - 11rem);
    }
  }
</style>
